---
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import "@/styles/global.css";
import "katex/dist/katex.min.css";
import { localeFromPath, localizedPath, text } from "@/lib/i18n";
import { sitePath } from "@/lib/sitePath";

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  canonical?: string | URL;
  ogImage?: string;
  breadcrumbs?: BreadcrumbItem[];
  ogType?: "website" | "article";
  hasJapanese?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = localeFromPath(Astro.url.pathname) === "ja" ? "/og-libra.png" : "/og-libra-en.png",
  breadcrumbs = [],
  ogType = "website",
  hasJapanese = true,
} = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = (en: string, ja: string) => text(locale, en, ja);
const homePath = localizedPath("/", locale);
const alternatePaths = hasJapanese ? [
  { locale: "en", path: localizedPath(Astro.url.pathname, "en") },
  { locale: "ja", path: localizedPath(Astro.url.pathname, "ja") },
] : [{ locale: "en", path: localizedPath(Astro.url.pathname, "en") }];

const siteName = "Libra";
const siteBase = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(typeof canonical === "string" ? sitePath(canonical) : canonical ?? Astro.url.pathname, siteBase);
canonicalUrl.search = "";
canonicalUrl.hash = "";

const ogImageUrl = ogImage ? new URL(sitePath(ogImage), siteBase).href : undefined;
const normalizePath = (path: string) =>
  path === "/" ? path : path.replace(/\/+$/, "");
const currentPath = normalizePath(Astro.url.pathname);

const suppliedBreadcrumbs = breadcrumbs.filter(
  (item, index) =>
    !(
      index === 0 &&
      (item.label === t("Home", "ホーム") ||
        (item.href &&
          normalizePath(new URL(sitePath(item.href), siteBase).pathname) === normalizePath(homePath)))
    ),
);
const breadcrumbItems: BreadcrumbItem[] = [
  currentPath === normalizePath(homePath)
    ? { label: t("Home", "ホーム") }
    : { label: t("Home", "ホーム"), href: homePath },
  ...suppliedBreadcrumbs.map((item) => ({ ...item, href: item.href ? sitePath(item.href) : undefined })),
];

if (currentPath !== normalizePath(homePath)) {
  const lastItem = breadcrumbItems.at(-1);
  const lastPath = lastItem?.href
    ? normalizePath(new URL(lastItem.href, siteBase).pathname)
    : undefined;

  if (lastPath === currentPath && lastItem) {
    breadcrumbItems[breadcrumbItems.length - 1] = { label: lastItem.label };
  } else if (!lastItem || lastItem.href) {
    breadcrumbItems.push({ label: title });
  }
}

const websiteUrl = new URL(homePath, siteBase).href;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${websiteUrl}#website`,
      name: siteName,
      url: websiteUrl,
      inLanguage: locale,
      description:
        t("An open knowledge base for mathematical and engineering objects, data, functions and documentation.", "数学・工学オブジェクトのデータ、関数、ドキュメントをまとめるオープンな知識ベースです。"),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbItems.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.label,
        item: item.href
          ? new URL(item.href, siteBase).href
          : canonicalUrl.href,
      })),
    },
  ],
};
const serializedStructuredData = JSON.stringify(structuredData).replace(
  /</g,
  "\\u003c",
);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />

    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl.href} />
    {alternatePaths.map((alternate) => <link rel="alternate" hreflang={alternate.locale} href={new URL(alternate.path, siteBase)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPath(Astro.url.pathname, "en"), siteBase)} />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={locale === "ja" ? "ja_JP" : "en_US"} />
    {hasJapanese && <meta property="og:locale:alternate" content={locale === "ja" ? "en_US" : "ja_JP"} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    {ogImageUrl && <meta property="og:image:alt" content="Libra" />}

    <meta
      name="twitter:card"
      content={ogImageUrl ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:image:alt" content="Libra" />}

    <script
      type="application/ld+json"
      is:inline
      set:html={serializedStructuredData}
    />
    <slot name="head" />
  </head>
  <body>
    <Header hasJapanese={hasJapanese} />
    <Breadcrumbs items={breadcrumbItems} />
    <main id="main-content" class="site-main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
