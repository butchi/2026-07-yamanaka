---
import StaticSequenceList from "@/components/concept/StaticSequenceList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { filterIntegerSequenceEntries, resolveObjectEntries } from "@/lib/objectEntries";
import { objectPagePath } from "@/lib/objectIdentity";
import { localeFromPath, localizedPath, text } from "@/lib/i18n";
import { resolveConstantEntries } from "@/lib/constantEntries";
const locale = localeFromPath(Astro.url.pathname);
const t = (en: string, ja: string) => text(locale, en, ja);
const path = (value: string) => localizedPath(value, locale);

const [objects, readmes, datasets, objectValues] = await Promise.all([
  getCollection("objects"),
  getCollection("objectReadmes"),
  getCollection("datasets"),
  getCollection("objectValues"),
]);
const sequences = filterIntegerSequenceEntries(objects, readmes);
const concepts = resolveObjectEntries(sequences.objects, sequences.readmes, datasets);
const constantEntries = resolveConstantEntries(objects, readmes, objectValues);
---

<BaseLayout
  title={t("Libra — A knowledge base for mathematical and engineering objects", "Libra — 数学・工学オブジェクトの知識ベース")}
  description={t("An open knowledge base bringing together data, functions and documentation for mathematical and engineering objects.", "Libraは数学的・工学的オブジェクトのデータ、関数、ドキュメントをまとめ、調べた内容を再利用できるオープンな知識ベースを目指します。")}
>
  <section class="libra-hero">
    <div class="libra-hero__copy">
      <p class="eyebrow">AN OPEN KNOWLEDGE BASE FOR OBJECTS</p>
      <h1>{t("Knowledge, ready to use.", "知識を、使えるかたちに。")}</h1>
      <p class="lead">
        {t("Explore mathematical and engineering objects through exact data, reusable functions and readable documentation. Libra helps you find, verify and apply knowledge.", "数学や工学のオブジェクトを、正確なデータ、再利用できる関数、読みやすいドキュメントとともに。Libraは知識を見つけ、確かめ、次の仕事につなげるためのカタログです。")}
      </p>
      <div class="hero-actions">
        <a class="primary-link" href={path("/numbers/")}>{t("Explore objects", "オブジェクトを探す")} <span aria-hidden="true">→</span></a>
        <a class="hero-secondary-link" href={path("/about/")}>{t("About Libra", "Libraについて")}</a>
      </div>
    </div>
    <aside class="libra-hero__note" aria-label={t("Libra editorial principle", "Libraの編集方針")}>
      <span class="hero-note-mark" aria-hidden="true">L</span>
      <p class="eyebrow">THE LIBRA PRINCIPLE</p>
      <p>Data.<br />Functions.<br />Documentation.</p>
      <small>{t("One object. One reliable reference.", "ひとつの項目に、ひとつの信頼できる参照先を。")}</small>
    </aside>
  </section>

  <section class="page-section home-catalog" aria-labelledby="featured-heading">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">EXPLORE THE CATALOG</p>
        <h2 id="featured-heading">{t("Explore objects", "オブジェクトを探す")}</h2>
      </div>
      <a href={path("/numbers/")}>{t("View the full catalog", "カタログをすべて見る")} <span aria-hidden="true">→</span></a>
    </div>
    <p class="section-intro">
      {t("Explore integer sequences and mathematical constants with exact data, clear approximations and readable documentation.", "整数列や数学定数を、厳密なデータ、明示された近似値、読みやすい解説とともに紹介します。")}
    </p>
    <div class="concept-grid">
      {concepts.map(({ concept, identity, digest, japaneseReadme }, index) => (
        <article class="concept-card libra-object-card">
          <div class="object-card-topline">
            <span class="object-index">{String(index + 1).padStart(2, "0")}</span>
            <span class="object-type">INTEGER SEQUENCE</span>
          </div>
          <p class="concept-card__english">{concept.meta.name.en}</p>
          <h3><a href={localizedPath(objectPagePath(identity), japaneseReadme ? locale : "en")}>{concept.meta.name[locale]}<span aria-hidden="true"> ↗</span></a></h3>
          <p class="object-description">{concept.meta.description?.[locale]}</p>
          <StaticSequenceList values={digest.data.terms.slice(0, 8)} />
          <a class="text-link" href={localizedPath(objectPagePath(identity), japaneseReadme ? locale : "en")}>
            {locale === "ja" && !japaneseReadme ? "日本語版は未提供・英語版を見る" : t("View data, functions and documentation", "データ・関数・解説を見る")} <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
      {constantEntries.map(({ object, identity, value }) => (
        <article class="concept-card libra-object-card">
          <div class="object-card-topline">
            <span class="object-index">{String(concepts.length + 1).padStart(2, "0")}</span>
            <span class="object-type">MATHEMATICAL CONSTANT</span>
          </div>
          <p class="concept-card__english">{object.data.name.en}</p>
          <h3><a href={localizedPath(objectPagePath(identity), locale)}>{object.data.name[locale]}<span aria-hidden="true"> ↗</span></a></h3>
          <p class="object-description">{object.data.translations?.ja?.seo.description && locale === "ja" ? object.data.translations.ja.seo.description : object.data.seo.description}</p>
          <p><code>{value.data.symbol} = {value.data.exactValue}</code></p>
          <a class="text-link" href={localizedPath(objectPagePath(identity), locale)}>
            {t("View exact value, approximation and documentation", "厳密値・近似値・解説を見る")} <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section libra-pillars" aria-labelledby="pillars-heading">
    <div class="pillar-intro">
      <p class="eyebrow">ONE OBJECT, THREE LENSES</p>
      <h2 id="pillars-heading">{t("Knowledge in reusable units.", "知識を、使い切れる単位で。")}</h2>
      <p>{t("Connect explanations, data and executable functions to support verification and reuse.", "読むだけで終わらせない。各項目の説明とデータ、実行可能な関数を結び、検証や再利用につなげます。")}</p>
    </div>
    <article>
      <span class="pillar-number">01 / DATA</span>
      <h3>{t("Unambiguous data", "曖昧さのないデータ")}</h3>
      <p>{t("Explicit values, indices, units and numeric types for people and programs.", "項の値、添字、単位、数値型などを明示。人にもプログラムにも扱いやすい形を目指します。")}</p>
    </article>
    <article>
      <span class="pillar-number">02 / FUNCTIONS</span>
      <h3>{t("Verifiable functions", "確かめて使える関数")}</h3>
      <p>{t("Generation and testing with clear contracts. Export results as code or standard formats.", "生成・判定・変換を明確な仕様とともに提供。結果をコードや標準形式で持ち出せます。")}</p>
    </article>
    <article>
      <span class="pillar-number">03 / DOCUMENTATION</span>
      <h3>{t("Documentation with context", "背景までわかる解説")}</h3>
      <p>{t("Definitions, properties, references and implementation limits in one place.", "定義、性質、出典、実装の境界をひとつの項目にまとめ、知識の理解を支えます。")}</p>
    </article>
  </section>

  <section class="page-section libra-contribute" aria-labelledby="contribute-heading">
    <div>
      <p class="eyebrow">BUILT IN THE OPEN</p>
      <h2 id="contribute-heading">{t("Contribute in the open.", "知識の追加も、オープンに。")}</h2>
    </div>
    <p>
      {t("Improve definitions and data through reviewable contributions on GitHub, sharing the evidence and history behind each change.", "Libraは、項目の定義やデータをレビュー可能なかたちで育てていくことを目指します。投稿や改善のフローにはGitHubを活用し、変更の根拠と履歴を共有します。")}
    </p>
    <a class="text-link" href={path("/about/")}>{t("Design principles and current scope", "設計方針と現在の範囲を見る")} <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
