---
import OperationAvailability from "@/components/concept/OperationAvailability.astro";
import StaticSequenceList from "@/components/concept/StaticSequenceList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { filterIntegerSequenceEntries, resolveObjectEntries } from "@/lib/objectEntries";
import { resolveConstantEntries } from "@/lib/constantEntries";
import { resolveDataObjectEntries } from "@/lib/dataObjectEntries";
import { objectPagePath } from "@/lib/objectIdentity";
import { localeFromPath, localizedPath, text } from "@/lib/i18n";
import { sitePath } from "@/lib/sitePath";
const locale = localeFromPath(Astro.url.pathname);
const t = (en: string, ja: string) => text(locale, en, ja);

const [objects, readmes, datasets, objectValues] = await Promise.all([
  getCollection("objects"),
  getCollection("objectReadmes"),
  getCollection("datasets"),
  getCollection("objectValues"),
]);
const sequences = filterIntegerSequenceEntries(objects, readmes);
const concepts = resolveObjectEntries(sequences.objects, sequences.readmes, datasets);
const constantEntries = resolveConstantEntries(objects, readmes, objectValues, datasets);
const dataObjectEntries = resolveDataObjectEntries(objects, readmes, datasets);
---

<BaseLayout
  title={t("Mathematical object catalog | Libra", "数学オブジェクトカタログ｜Libra")}
  description={t("Explore mathematical sequences, constants and structured data through exact values and documentation.", "数学の数列や定数、構造化データを、正確な値と解説とともに紹介します。")}
  breadcrumbs={[{ label: t("Catalog", "カタログ") }, { label: t("Mathematical objects", "数学オブジェクト") }]}
>
  <header class="page-header">
    <p class="eyebrow">LIBRA / CATALOG / MATHEMATICAL OBJECTS</p>
    <h1>{t("Mathematical object catalog", "数学オブジェクトカタログ")}</h1>
    <p class="lead">
      {t("Explore integer sequences, mathematical constants and other structured data. Each object documents its data and conventions.", "整数列や数学定数に加え、さまざまな構造化データを紹介します。各項目でデータと扱いを明示します。")}
    </p>
  </header>

  <div class="catalog-list">
    {concepts.map(({ concept, identity, digest, japaneseReadme }) => {
      const target = localizedPath(objectPagePath(identity), japaneseReadme ? locale : "en");
      const availability = {
        number: concept.capabilities.number.map(({ operation }) => operation),
        bigint: concept.capabilities.bigint.map(({ operation }) => operation),
      };

      return (
        <article class="catalog-item">
          <div class="catalog-item__summary">
            <div>
              <p class="concept-card__english">{concept.meta.name.en}</p>
              <h2><a href={target}>{concept.meta.name[locale]}<span aria-hidden="true"> ↗</span></a></h2>
            </div>
            <div class="catalog-item__identifiers">
              {concept.meta.oeis?.map((oeis) => (
                <a href={`https://oeis.org/${oeis}`} aria-label={t(`View ${oeis} on OEIS`, `${oeis}をOEISで見る`)}>{oeis}</a>
              ))}
            </div>
          </div>
          <p>{concept.meta.description?.[locale]}</p>
          <StaticSequenceList values={digest.data.terms.slice(0, 10)} />
          <p class="dataset-links">
            <a href={sitePath(`/objects/${identity.id}/data/digest.json`)} target="_blank" rel="noopener">{t("Digest JSON (16 terms)", "ダイジェストJSON（16項）")}</a>
            <a href={sitePath(`/objects/${identity.id}/data/standard.json`)} target="_blank" rel="noopener">{t("Standard JSON (256 terms)", "標準JSON（256項）")}</a>
          </p>
          <OperationAvailability availability={availability} />
          <div class="catalog-item__footer">
            <p>
              <span class="support-badge">{t("Number supported", "Number対応")}</span>
              <span class="support-badge">{t("BigInt supported", "BigInt対応")}</span>
            </p>
            <a class="primary-link" href={target}>{locale === "ja" && !japaneseReadme ? "日本語版は未提供・英語版を見る" : t(`Explore ${concept.meta.name.en}`, `${concept.meta.name.ja}の詳細へ`)}</a>
          </div>
        </article>
      );
    })}
    {constantEntries.map(({ object, identity, value, digest }) => (
      <article class="catalog-item">
        <div class="catalog-item__summary">
          <div>
            <p class="concept-card__english">{object.data.name.en}</p>
            <h2><a href={localizedPath(objectPagePath(identity), locale)}>{object.data.name[locale]}<span aria-hidden="true"> ↗</span></a></h2>
          </div>
          <span class="support-badge">{t("Irrational constant", "無理数の定数")}</span>
        </div>
        <p>{object.data.translations?.ja?.seo.description && locale === "ja" ? object.data.translations.ja.seo.description : object.data.seo.description}</p>
        <dl class="definition-grid">
          <div>
            <dt>{t("Exact value", "厳密値")}</dt>
            <dd class="exact-value-math">
              <span class="visually-hidden">{value.data.symbol} = {value.data.exactValue}</span>
              <span set:html={value.data.exactValuePresentationMathML} />
            </dd>
          </div>
          <div>
            <dt>{t("Digest approximation (16 decimal places)", "ダイジェスト近似値（小数点以下16桁）")}</dt>
            <dd><code>{digest.data.value}</code></dd>
          </div>
        </dl>
        <p class="dataset-links">
          <a href={sitePath(`/objects/${identity.id}/data/digest.json`)} target="_blank" rel="noopener">{t("Digest JSON", "ダイジェストJSON")}</a>
          <a href={sitePath(`/objects/${identity.id}/data/standard.json`)} target="_blank" rel="noopener">{t("Standard JSON (256 decimal places)", "標準JSON（小数点以下256桁）")}</a>
        </p>
        <div class="catalog-item__footer">
          <p><span class="support-badge">{t("Exact symbolic value", "記号による厳密値")}</span></p>
          <a class="primary-link" href={localizedPath(objectPagePath(identity), locale)}>{t(`Explore ${object.data.name.en}`, `${object.data.name.ja}の詳細へ`)}</a>
        </div>
      </article>
    ))}
    {dataObjectEntries.map(({ object, identity, content, japaneseReadme }) => {
      const target = localizedPath(objectPagePath(identity), japaneseReadme ? locale : "en");
      return (
        <article class="catalog-item">
          <div class="catalog-item__summary">
            <div>
              <p class="concept-card__english">{object.data.name.en}</p>
              <h2><a href={target}>{object.data.name[locale]}<span aria-hidden="true"> ↗</span></a></h2>
            </div>
            <span class="support-badge">{t("JSON data", "JSONデータ")}</span>
          </div>
          <p>{object.data.translations?.ja?.seo.description && locale === "ja" ? object.data.translations.ja.seo.description : object.data.seo.description}</p>
          {content.data.format === "matrix" ? (
            <p>{t(
              `${content.data.values.length} × ${content.data.values[0].length} matrix excerpt`,
              `行列データ（${content.data.values.length} × ${content.data.values[0].length}項の抜粋）`,
            )}</p>
          ) : <pre><code>{JSON.stringify(content.data.value)}</code></pre>}
          <p class="dataset-links">
            <a href={sitePath(`/objects/${identity.id}/data/content.json`)} target="_blank" rel="noopener">{t("JSON data", "JSONデータ")}</a>
          </p>
          <div class="catalog-item__footer">
            <p><span class="support-badge">{content.data.format === "matrix" ? t("Matrix", "行列") : t("Arbitrary JSON value", "任意のJSON値")}</span></p>
            <a class="primary-link" href={target}>{locale === "ja" && !japaneseReadme ? "日本語版は未提供・英語版を見る" : t(`Explore ${object.data.name.en}`, `${object.data.name.ja}の詳細へ`)}</a>
          </div>
        </article>
      );
    })}
  </div>
</BaseLayout>
