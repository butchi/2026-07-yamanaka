---
import { localeFromPath, text } from "@/lib/i18n";
interface ImplementationInfo {
  numericType: "number" | "bigint";
  operation: string;
  operationLabel: string;
  source: "native" | "derived";
  derivedFrom?: string;
  implementationId?: string;
  algorithmId?: string;
  algorithmName?: string;
  complexity?: Record<string, string>;
  verification?: { method: string; maxInput?: string | number };
  benchmarkId?: string;
}

interface Props {
  implementations: ImplementationInfo[];
}

const { implementations } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = (en: string, ja: string) => text(locale, en, ja);
const complexityLabels: Record<string, string> = {
  time: t("Time complexity", "時間計算量"),
  space: t("Space complexity", "空間計算量"),
  arithmeticSteps: t("Arithmetic steps", "算術ステップ"),
  bitComplexity: t("Bit complexity", "ビット計算量"),
  outputSize: t("Output size", "出力量"),
  notes: t("Notes", "補足"),
};
---

<div class="implementation-list">
  {implementations.map((item) => (
    <details>
      <summary>
        <span>{item.operationLabel}</span>
        <span class="type-badge">{item.numericType === "number" ? "Number" : "BigInt"}</span>
        <span>{item.algorithmName ?? t("No implementation details", "実装情報なし")}</span>
      </summary>
      <dl class="definition-grid definition-grid--compact">
        <div>
          <dt>{t("Implementation", "実装")}</dt>
          <dd>{item.source === "native" ? t("Native implementation", "ネイティブ実装") : t(`Derived from ${item.derivedFrom ?? "another operation"}`, `派生実装（${item.derivedFrom ?? "既存操作"}から生成）`)}</dd>
        </div>
        {item.implementationId && (
          <div>
            <dt>implementationId</dt>
            <dd><code>{item.implementationId}</code></dd>
          </div>
        )}
        {item.algorithmId && (
          <div>
            <dt>algorithmId</dt>
            <dd><code>{item.algorithmId}</code></dd>
          </div>
        )}
        {item.complexity && Object.entries(item.complexity).map(([key, value]) => (
          <div>
            <dt>{complexityLabels[key] ?? key}</dt>
            <dd lang="en">{value}</dd>
          </div>
        ))}
        {item.verification && (
          <div>
            <dt>{t("Verification method", "検証方法")}</dt>
            <dd>
              <span lang="en">{item.verification.method}</span>
              {item.verification.maxInput != null && t(` (maximum input: ${item.verification.maxInput})`, `（最大入力: ${item.verification.maxInput}）`)}
            </dd>
          </div>
        )}
        {item.benchmarkId && (
          <div>
            <dt>{t("Benchmark reference ID", "ベンチマーク参照ID")}</dt>
            <dd><code>{item.benchmarkId}</code></dd>
          </div>
        )}
      </dl>
    </details>
  ))}
</div>
