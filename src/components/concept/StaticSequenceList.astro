---
import { localeFromPath, text } from "@/lib/i18n";
const locale = localeFromPath(Astro.url.pathname);
interface Props {
  values: Array<number | bigint | string>;
  numericType?: "number" | "bigint";
}

const { values, numericType = "number" } = Astro.props;
const formatted = values.map((value) =>
  numericType === "bigint" || typeof value === "bigint" ? `${value.toString()}n` : value.toString(),
);
---

<div class="sequence-strip" data-testid="static-sequence-list" tabindex="0">
  <ol aria-label={text(locale, "First terms", "最初の数項")}>
    {formatted.map((value, index) => (
      <li aria-label={`${text(locale, "Index", "添字")} ${index}: ${value}`}>
        <span class="sequence-strip__index" data-index={index} aria-hidden="true"></span>
        <span class="sequence-strip__term">
          <code>{value}</code>{index < formatted.length - 1 && <span class="sequence-strip__separator" aria-hidden="true">,</span>}
        </span>
      </li>
    ))}
  </ol>
</div>
