---
import { localeFromPath, operationLabels as labelsFor, text } from "@/lib/i18n";
export type OperationName = "term" | "take" | "upTo" | "has" | "next";

interface Props {
  availability: {
    number: OperationName[];
    bigint: OperationName[];
  };
}

const { availability } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = (en: string, ja: string) => text(locale, en, ja);
const operationLabels = labelsFor(locale);
---

<div class="availability-table" role="region" aria-label={t("Available operations", "利用可能な操作")}>
  <table>
    <thead>
      <tr>
        <th scope="col">{t("Numeric type", "数値型")}</th>
        {Object.entries(operationLabels).map(([operation, label]) => (
          <th scope="col" title={operation}>{label}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {(["number", "bigint"] as const).map((numericType) => (
        <tr>
          <th scope="row">{numericType === "number" ? "Number" : "BigInt"}</th>
          {(Object.keys(operationLabels) as OperationName[]).map((operation) => (
            <td>
              {availability[numericType].includes(operation) ? (
                <span class="availability-yes" aria-label={t("Available", "利用可能")}>{t("Yes", "利用可")}</span>
              ) : (
                <span class="availability-no" aria-label={t("Unavailable", "提供なし")}>—</span>
              )}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
