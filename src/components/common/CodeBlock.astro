---
import { localeFromPath, text } from "@/lib/i18n";
interface Props {
  code: string;
  label?: string;
}

const locale = localeFromPath(Astro.url.pathname);
const { code, label = text(locale, "Code example", "コード例") } = Astro.props;
---

<copy-code class="code-block">
  <div class="code-block__bar">
    <span>{label}</span>
    <button type="button" data-copy-code>{text(locale, "Copy code", "コードをコピー")}</button>
  </div>
  <pre tabindex="0"><code>{code}</code></pre>
  <span class="visually-hidden" aria-live="polite" data-copy-status></span>
</copy-code>

<script>
  import { localeFromPath, text } from "../../lib/i18n";
  class CopyCode extends HTMLElement {
    connectedCallback() {
      const t = (en: string, ja: string) => text(localeFromPath(location.pathname), en, ja);
      const button = this.querySelector<HTMLButtonElement>("[data-copy-code]");
      const code = this.querySelector("code");
      const status = this.querySelector<HTMLElement>("[data-copy-status]");

      button?.addEventListener("click", async () => {
        if (!code || !status) return;

        try {
          await navigator.clipboard.writeText(code.textContent ?? "");
          status.textContent = t("Code copied.", "コードをコピーしました。");
          button.textContent = t("Copied", "コピーしました");
          window.setTimeout(() => {
            button.textContent = t("Copy code", "コードをコピー");
          }, 1800);
        } catch {
          status.textContent = t("Copy failed. Select and copy the code manually.", "コピーできませんでした。コードを選択してコピーしてください。");
        }
      });
    }
  }

  if (!customElements.get("copy-code")) {
    customElements.define("copy-code", CopyCode);
  }
</script>
