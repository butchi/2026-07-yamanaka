---
import ConstantPage from "@/components/pages/ConstantPage.astro";
import { resolveConstantEntries } from "@/lib/constantEntries";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const [objects, readmes, values, datasets] = await Promise.all([
    getCollection("objects"),
    getCollection("objectReadmes"),
    getCollection("objectValues"),
    getCollection("datasets"),
  ]);
  return resolveConstantEntries(objects, readmes, values, datasets).map(({ object, identity, readme, japaneseReadme, value, digest, standard, relatedObjects }) => ({
    params: { slug: identity.slug },
    props: { constant: object, identity, readme, japaneseReadme, value, digest, standard, relatedObjects },
  }));
}

---
<ConstantPage {...Astro.props} />
