---
import { getCollection } from "astro:content";
import ObjectLayout from "@/layouts/ObjectLayout.astro";
import { filterIntegerSequenceEntries, resolveObjectEntries } from "@/lib/objectEntries";

export async function getStaticPaths() {
  const [allObjects, allReadmes, datasets] = await Promise.all([
    getCollection("objects"), getCollection("objectReadmes"), getCollection("datasets"),
  ]);
  const sequences = filterIntegerSequenceEntries(allObjects, allReadmes);
  return resolveObjectEntries(sequences.objects, sequences.readmes, datasets)
    .flatMap((entry) => entry.japaneseReadme ? [{
      params: { slug: entry.identity.slug },
      props: { ...entry, readme: entry.japaneseReadme },
    }] : []);
}
---

<ObjectLayout {...Astro.props} />
