---
import StaticSequenceList from "@/components/concept/StaticSequenceList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { conceptRegistry, publishedConcepts } from "@/lib/conceptRegistry";

const concepts = publishedConcepts.map((id) => conceptRegistry[id]);
---

<BaseLayout
  title="Libra — 数学・工学オブジェクトの知識ベース"
  description="Libraは数学的・工学的オブジェクトのデータ、関数、ドキュメントをまとめ、調べた内容を再利用できるオープンな知識ベースを目指します。"
>
  <section class="libra-hero">
    <div class="libra-hero__copy">
      <p class="eyebrow">AN OPEN KNOWLEDGE BASE FOR OBJECTS</p>
      <h1>知識を、<br />使えるかたちに。</h1>
      <p class="lead">
        数学や工学のオブジェクトを、正確なデータ、再利用できる関数、読みやすいドキュメントとともに。
        Libraは知識を見つけ、確かめ、次の仕事につなげるためのカタログです。
      </p>
      <div class="hero-actions">
        <a class="primary-link" href="/numbers/">オブジェクトを探す <span aria-hidden="true">→</span></a>
        <a class="hero-secondary-link" href="/about/">Libraについて</a>
      </div>
    </div>
    <aside class="libra-hero__note" aria-label="Libraの編集方針">
      <span class="hero-note-mark" aria-hidden="true">L</span>
      <p class="eyebrow">THE LIBRA PRINCIPLE</p>
      <p>Data.<br />Functions.<br />Documentation.</p>
      <small>ひとつの項目に、ひとつの信頼できる参照先を。</small>
    </aside>
  </section>

  <section class="page-section home-catalog" aria-labelledby="featured-heading">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">EXPLORE THE CATALOG</p>
        <h2 id="featured-heading">オブジェクトを探す</h2>
      </div>
      <a href="/numbers/">カタログをすべて見る <span aria-hidden="true">→</span></a>
    </div>
    <p class="section-intro">
      まずはOEISに着想を得た数列カタログから。定義とデータを読み、関数を試し、コードに持ち帰れます。
    </p>
    <div class="concept-grid">
      {concepts.map((concept, index) => (
        <article class="concept-card libra-object-card">
          <div class="object-card-topline">
            <span class="object-index">{String(index + 1).padStart(2, "0")}</span>
            <span class="object-type">INTEGER SEQUENCE</span>
          </div>
          <p class="concept-card__english">{concept.meta.name.en}</p>
          <h3><a href={`/numbers/${concept.id}/`}>{concept.meta.name.ja}<span aria-hidden="true"> ↗</span></a></h3>
          <p class="object-description">{concept.meta.description?.ja}</p>
          <StaticSequenceList values={concept.staticTerms.slice(0, 8)} />
          <a class="text-link" href={`/numbers/${concept.id}/`}>
            データ・関数・解説を見る <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section libra-pillars" aria-labelledby="pillars-heading">
    <div class="pillar-intro">
      <p class="eyebrow">ONE OBJECT, THREE LENSES</p>
      <h2 id="pillars-heading">知識を、使い切れる単位で。</h2>
      <p>読むだけで終わらせない。各項目の説明とデータ、実行可能な関数を結び、検証や再利用につなげます。</p>
    </div>
    <article>
      <span class="pillar-number">01 / DATA</span>
      <h3>曖昧さのないデータ</h3>
      <p>項の値、添字、単位、数値型などを明示。人にもプログラムにも扱いやすい形を目指します。</p>
    </article>
    <article>
      <span class="pillar-number">02 / FUNCTIONS</span>
      <h3>確かめて使える関数</h3>
      <p>生成・判定・変換を明確な仕様とともに提供。結果をコードや標準形式で持ち出せます。</p>
    </article>
    <article>
      <span class="pillar-number">03 / DOCUMENTATION</span>
      <h3>背景までわかる解説</h3>
      <p>定義、性質、出典、実装の境界をひとつの項目にまとめ、知識の理解を支えます。</p>
    </article>
  </section>

  <section class="page-section libra-contribute" aria-labelledby="contribute-heading">
    <div>
      <p class="eyebrow">BUILT IN THE OPEN</p>
      <h2 id="contribute-heading">知識の追加も、オープンに。</h2>
    </div>
    <p>
      Libraは、項目の定義やデータをレビュー可能なかたちで育てていくことを目指します。
      投稿や改善のフローにはGitHubを活用し、変更の根拠と履歴を共有します。
    </p>
    <a class="text-link" href="/about/">設計方針と現在の範囲を見る <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
