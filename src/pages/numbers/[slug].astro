---
import { getCollection } from "astro:content";
import ObjectLayout from "@/layouts/ObjectLayout.astro";
import { resolveObjectEntries } from "@/lib/objectEntries";

export async function getStaticPaths() {
  const [objects, documents] = await Promise.all([
    getCollection("objects"),
    getCollection("documents"),
  ]);

  return resolveObjectEntries(objects, documents).map((entry) => ({
    params: { slug: entry.concept.id },
    props: entry,
  }));
}
---

<ObjectLayout {...Astro.props} />
