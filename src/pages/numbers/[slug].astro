---
import { getCollection } from "astro:content";
import ObjectLayout from "@/layouts/ObjectLayout.astro";
import { resolveObjectEntries } from "@/lib/objectEntries";

export async function getStaticPaths() {
  const [objects, readmes, datasets] = await Promise.all([
    getCollection("objects"),
    getCollection("objectReadmes"),
    getCollection("datasets"),
  ]);

  return resolveObjectEntries(objects, readmes, datasets).map((entry) => ({
    params: { slug: entry.concept.id },
    props: entry,
  }));
}
---

<ObjectLayout {...Astro.props} />
