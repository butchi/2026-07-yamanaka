---
import OperationAvailability from "@/components/concept/OperationAvailability.astro";
import StaticSequenceList from "@/components/concept/StaticSequenceList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { resolveObjectEntries } from "@/lib/objectEntries";
import { objectPagePath } from "@/lib/objectIdentity";

const [objects, readmes, datasets] = await Promise.all([
  getCollection("objects"),
  getCollection("objectReadmes"),
  getCollection("datasets"),
]);
const concepts = resolveObjectEntries(objects, readmes, datasets);
---

<BaseLayout
  title="整数列カタログ｜Libra"
  description="フィボナッチ数、素数、平方数のデータ、数学的な定義、利用可能な関数をまとめたLibraの整数列カタログです。"
  breadcrumbs={[{ label: "カタログ" }, { label: "整数列" }]}
>
  <header class="page-header">
    <p class="eyebrow">LIBRA / CATALOG / SEQUENCES</p>
    <h1>整数列カタログ</h1>
    <p class="lead">
      数列の定義とデータを読み、関数を試せるオブジェクトカタログです。
      各項目では添字や値の扱いを明示し、出典となるOEISエントリと実装情報を結びます。
    </p>
  </header>

  <div class="catalog-list">
    {concepts.map(({ concept, identity, digest }) => {
      const availability = {
        number: concept.capabilities.number.map(({ operation }) => operation),
        bigint: concept.capabilities.bigint.map(({ operation }) => operation),
      };

      return (
        <article class="catalog-item">
          <div class="catalog-item__summary">
            <div>
              <p class="concept-card__english">{concept.meta.name.en}</p>
              <h2><a href={objectPagePath(identity)}>{concept.meta.name.ja}<span aria-hidden="true"> ↗</span></a></h2>
            </div>
            <div class="catalog-item__identifiers">
              {concept.meta.oeis?.map((oeis) => (
                <a href={`https://oeis.org/${oeis}`} aria-label={`${oeis}をOEISで見る`}>{oeis}</a>
              ))}
            </div>
          </div>
          <p>{concept.meta.description?.ja}</p>
          <StaticSequenceList values={digest.data.terms.slice(0, 10)} />
          <p class="dataset-links">
            <a href={`/objects/${identity.id}/data/digest.json`} target="_blank" rel="noopener">ダイジェストJSON（16項）</a>
            <a href={`/objects/${identity.id}/data/standard.json`} target="_blank" rel="noopener">標準JSON（256項）</a>
          </p>
          <OperationAvailability availability={availability} />
          <div class="catalog-item__footer">
            <p>
              <span class="support-badge">Number対応</span>
              <span class="support-badge">BigInt対応</span>
            </p>
            <a class="primary-link" href={objectPagePath(identity)}>{concept.meta.name.ja}の詳細へ</a>
          </div>
        </article>
      );
    })}
  </div>
</BaseLayout>
